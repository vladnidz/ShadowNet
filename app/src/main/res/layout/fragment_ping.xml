<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ PING MONITOR"
        android:textColor="@color/neon_green"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPingTarget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Шлюз: 192.168.1.1"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvCurrentPing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="-- ms"
        android:textColor="@color/neon_green"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPingStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Мин: -- ms | Ср: -- ms | Макс: -- ms\nПотери: 0%"
        android:textColor="@color/text_white"
        android:textSize="11sp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnTogglePing"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/neon_green"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Запустить пинг"
        android:textColor="@color/black"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
